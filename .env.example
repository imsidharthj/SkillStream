# "voice" (LiveKit + STT + TTS + avatar) or "chat" (text only, needs only GROQ_API_KEY)
INTERACTION_MODE=voice

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=en
# Must support tool calling + streaming on Groq
GROQ_CHAT_MODEL=openai/gpt-oss-120b

ELEVEN_API_KEY=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=

# "liveavatar" or "static"
AVATAR_PROVIDER=liveavatar
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
